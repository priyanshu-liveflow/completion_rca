# Provider: aws | azure | ollama | openai_compat
CLOUD_PROVIDER=aws

# AWS Bedrock (when CLOUD_PROVIDER=aws)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# MODEL_ID=us.anthropic.claude-sonnet-4-6

# Bright Data CLI (`bdata`). Auth for search / scrape / collectors.
# BRIGHTDATA_API_KEY=
# BRIGHTDATA_SERP_ZONE=        # required for `bdata search`
# BRIGHTDATA_UNLOCKER_ZONE=    # required for `bdata scrape`
# OpenAI-compatible endpoint (when CLOUD_PROVIDER=openai_compat)
# NVIDIA NIM: https://integrate.api.nvidia.com/v1
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=
# LLM_MODEL=meta/llama-3.3-70b-instruct
