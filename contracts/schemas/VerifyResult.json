{
  "$defs": {
    "Patch": {
      "description": "Unified diff the agent authored against the sandbox working tree.",
      "properties": {
        "diff": {
          "title": "Diff",
          "type": "string"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "diff",
        "files",
        "rationale"
      ],
      "title": "Patch",
      "type": "object"
    },
    "TestCase": {
      "description": "One pytest node and its outcome.",
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "error",
            "skipped"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "duration_s": {
          "title": "Duration S",
          "type": "number"
        },
        "traceback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Traceback"
        }
      },
      "required": [
        "node_id",
        "outcome",
        "duration_s",
        "traceback"
      ],
      "title": "TestCase",
      "type": "object"
    },
    "TestReport": {
      "description": "Parsed result of one sandbox test run against a package version.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "package": {
          "title": "Package",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/TestCase"
          },
          "title": "Cases",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "failed": {
          "title": "Failed",
          "type": "integer"
        },
        "errors": {
          "default": 0,
          "title": "Errors",
          "type": "integer"
        },
        "duration_s": {
          "title": "Duration S",
          "type": "number"
        },
        "raw_tail": {
          "title": "Raw Tail",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        }
      },
      "required": [
        "id",
        "package",
        "version",
        "cases",
        "passed",
        "failed",
        "duration_s",
        "raw_tail"
      ],
      "title": "TestReport",
      "type": "object"
    }
  },
  "description": "Before/after test reports for a patch.\n\n`verified` is the PR gate and is DERIVED, never supplied. It must be\n`before.is_broken and after.is_green`; do not use `before.failed > 0`,\nbecause a collection error is broken with failed=0.\n\nIt is a `computed_field` rather than a plain `bool` on purpose. The one\ncaller that reaches this model with untrusted input is\n`mcp/store_server.py::save_verify`, which does\n`VerifyResult.model_validate(result)` on a dict the *agent* wrote. If\n`verified` were an ordinary field, an agent could post\n`{\"verified\": true}` beside a red `after` report and `core.patch.can_act`\nwould open the PR on evidence that never went green. Deriving it means the\ngate is computed from the two test reports every time it is read, whether\nthe model came from `build_verify_result`, from agent JSON, or from a row\nreloaded out of SQLite.",
  "properties": {
    "patch": {
      "$ref": "#/$defs/Patch"
    },
    "before": {
      "$ref": "#/$defs/TestReport"
    },
    "after": {
      "$ref": "#/$defs/TestReport"
    }
  },
  "required": [
    "patch",
    "before",
    "after"
  ],
  "title": "VerifyResult",
  "type": "object"
}
