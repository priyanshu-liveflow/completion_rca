        {
          "$ref": "#/$defs/HealthVerdict"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "spec_id",
    "rows",
    "health"
  ],
  "title": "CollectorRun",
  "type": "object"
}
